# ─── Supabase ─────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# RAHASIA — hanya dipakai di server. JANGAN beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Situs ────────────────────────────────────────────────
# URL publik tanpa garis miring di akhir (dipakai untuk link undangan & Open Graph)
NEXT_PUBLIC_SITE_URL=https://elkhi-veni.vercel.app

# ─── Admin (halaman /admin untuk membuat link & kirim WhatsApp) ──
# Kata sandi panjang & acak, minimal 12 karakter
ADMIN_PASSWORD=
